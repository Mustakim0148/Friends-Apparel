rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Orders collection: Allow creating, tracking, live listening, and admin updates/deletions
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Users collection: Allow customers to register, sign in, and admin to view/manage users
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Catalog & Districts collections: Publicly readable and editable
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    match /districts/{districtId} {
      allow read: if true;
      allow write: if true;
    }

    match /hero_slides/{slideId} {
      allow read: if true;
      allow write: if true;
    }

    match /heroSlides/{slideId} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
